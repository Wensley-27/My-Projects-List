pipeline {

    agent {
        docker {
            image 'wensley01/Jenkins_agent:v1'
            args '-v /var/run/docker.sock:/var/run/docker.sock'
        }
    }

    stages {

        stage('Checkout') {
            steps {

                git branch: 'master',
                    url: 'https://github.com/Wensley-27/My-Projects-List.git'

                echo 'Passed the checkout stage'
            }
        }

         stage('Build and Push Docker Image') {

            environment {
            DOCKER_IMAGE = "wensley01/my-personalbrand-website:${BUILD_NUMBER}"
                        }

        steps {

            dir('Java-myapp') {
            script {
                def image = docker.build(
                    DOCKER_IMAGE,
                    "-f Dockerfile .")
                docker.withRegistry(
                    'https://index.docker.io/v1/',
                    'docker-cred') 
                {
                    image.push()
                }

            }

        }

    }
}
       
        stage ('deploy to kubernetes') {
          steps {
            script {
              sh 'kubectl apply -f k8s/deployment.yaml'
              sh 'kubectl apply -f k8s/service.yaml'
            }
          }
    }
    }
}

    



pipeline {
    agent {
        docker {
        image 'wensley01/jenkins_agent:v3'
        args '-v /var/run/docker.sock:/var/run/docker.sock --network jenkins-sonar'
     }
  }

  environment {
        DOCKER_IMAGE = "wensley01/my-personalbrand-website:${BUILD_NUMBER}"
    }


stages {
stage('Checkout SCM') {

    steps {
        git branch: 'master',
            url: 'https://github.com/Wensley-27/My-Projects-List'

        echo 'Passed the checkout stage'
    }
}


stage('Build') {

    steps {
        dir('Java-myapp') {

            sh 'ls -ltr'
            sh 'mvn clean package'

        }

        echo 'Passed the build stage'
    }
}
        
  stage('Static Code Analysis') {
    environment {
        SONAR_URL = 'http://sonarqube:9000'
    }
    steps {
        dir('Java-myapp') {
            withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) 
            {
                sh 'ls -ltr'
                sh 'mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.login=$SONAR_AUTH_TOKEN -Dsonar.host.url=${SONAR_URL}'
            }
        }
        echo 'Passed the Static Code Analysis stage'
    }
}


stage('Docker Permission Check') {
    steps {
        sh '''
            echo "===== USER ====="
            whoami
            id

            echo "===== DOCKER SOCKET ====="
            ls -ln /var/run/docker.sock

            echo "===== DOCKER GROUP ====="
            getent group 106 || true

            echo "===== DOCKER VERSION ====="
            docker version
        '''
    }
}

stage('Build Docker Image') {
steps {
 dir('Java-myapp') {
        script {
            docker.build(DOCKER_IMAGE, '.')
        }
    }
}
}
   
stage('Push Docker Image') {

    steps {
        script {

            docker.withRegistry('https://index.docker.io/v1/', 'docker-cred') {

                docker.image(DOCKER_IMAGE).push()

            }
        }
    }
}

    
stage('Update Deployment File') {
    environment {
        GIT_REPO_NAME = 'My-Projects-List'
        GIT_USER_NAME = 'Wensley-27'
    }
    steps {
        withCredentials([string(credentialsId: 'Github', variable: 'GITHUB_TOKEN')]) {
            sh '''
                git config user.email "wensleyrajkumar@outlook.com"
                git config user.name "Wensley-27"
                sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" deployment.yaml
                git add deployment.yaml
                git diff --cached --quiet || git commit -m "Update deployment image to version ${BUILD_NUMBER}"
                git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git HEAD:master
            '''
        }
    }
}

}
}


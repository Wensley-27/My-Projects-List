
//1. Agent Configuration (agent)

pipeline {
  agent {
    docker {
      image 'Wensley/myfirst_ci_cd-docker-agent:v1'
      args '--user root -v /var/run/docker.sock:/var/run/docker.sock --add-host=host.docker.internal:host-gateway' //Since Jenkins directly on my your local machine's operating system, This flag maps  container to easily reach host services using host.docker.internal
        }
  }

//2. Pipeline Stages (stages)

  stages {
    stage('Checkout') {
      steps {
        sh 'echo passed'
        //git branch: 'main', url: 'https://github.com/Wensley-27/My-Projects-List.git'
      }
    }

//3. Build and Test (Stages)
    stage('Build and Test') {
      steps {
        sh 'ls -ltr'
        // build the project and create a JAR file
        sh 'cd myfirst_ci_cd/spring-boot-app && mvn clean package'
      }
    }
    stage('Static Code Analysis') {
      environment {
        SONAR_URL = "http://172.20.228.202:9000/"
      }
      steps {
        withCredentials([string(credentialsId: 'admin', variable: 'Keeppraying@0123')]) {
          sh 'cd myfirst_ci_cd/spring-boot-app && mvn sonar:sonar -Dsonar.login=$SONAR_AUTH_TOKEN -Dsonar.host.url=${SONAR_URL}'
        }
      }
    }
    stage('Build and Push Docker Image') {
      environment {
        DOCKER_IMAGE = "Wensley/ultimate-cicd:${BUILD_NUMBER}"
        // DOCKERFILE_LOCATION = "myfirst_ci_cd/spring-boot-app/Dockerfile"
        REGISTRY_CREDENTIALS = credentials('docker-cred')
      }
      steps {
        script {
            sh 'cd myfirst_ci_cd/spring-boot-app && docker build -t ${DOCKER_IMAGE} .'
            def dockerImage = docker.image("${DOCKER_IMAGE}")
            docker.withRegistry('https://index.docker.io/v1/', "docker-cred") {
                dockerImage.push()
            }
        }
      }
    }
    stage('Update Deployment File') {
        environment {
            GIT_REPO_NAME = "My-Projects-List"
            GIT_USER_NAME = "Wensley-27"
        }
        steps {
            withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                sh '''
                    git config user.email "wensleyrajkumar@outlook.com"
                    git config user.name "Wensley-27"
                    BUILD_NUMBER=${BUILD_NUMBER}
                    sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" myfirst_ci_cd/spring-boot-app-manifests/deployment.yml
                    git add myfirst_ci_cd/spring-boot-app-manifests/deployment.yml
                    git commit -m "Update deployment image to version ${BUILD_NUMBER}"
                    git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:master
                '''
            }
        }
    }
  }
}

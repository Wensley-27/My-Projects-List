pipeline {
  agent any // Runs directly on your native operating system workspace

  stages {
    stage('Checkout') {
      steps {
        sh 'echo passed'
        // Jenkins automatically handles checkout when triggered from a Git repo job
      }
    }

    stage('Build and Test') {
      steps {
        sh 'ls -ltr'
        // Build the project and create a JAR file
        sh 'cd myfirst_ci_cd/spring-boot-app && mvn clean package'
      }
    }

   stage('Static Code Analysis') {
    steps {
        withCredentials([string(credentialsId: 'sonar-token', variable: 'SONAR_TOKEN')]) {
            sh '''
                cd myfirst_ci_cd/spring-boot-app
                mvn sonar:sonar \
                  -Dsonar.token=$SONAR_TOKEN \
                  -Dsonar.host.url=http://172.20.228.202:9000 \
                  -Dsonar.java.binaries=target/classes \
            	  -Dsonar.sources=src/main/java
		'''
        }
    }
}

    stage('Build and Push Docker Image') {
      environment {
        DOCKER_IMAGE = "Wensley/ultimate-cicd:${BUILD_NUMBER}"
      }
      steps {
        // Using direct shell commands avoids socket/mounting permission discrepancies on native OS setups
        withCredentials([usernamePassword(credentialsId: 'docker-cred', usernameVariable: 'DOCKER_USER', passwordVariable: 'DOCKER_PASS')]) {
          sh '''
            cd myfirst_ci_cd/spring-boot-app
            docker login -u "$DOCKER_USER" -p "$DOCKER_PASS"
            docker build -t ${DOCKER_IMAGE} .
            docker push ${DOCKER_IMAGE}
          '''
        }
      }
    }

    stage('Update Deployment File') {
      environment {
        GIT_REPO_NAME = "My-Projects-List"
        GIT_USER_NAME = "Wensley-27"
      }
      steps {
        withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
          sh '''
            git config user.email "wensleyrajkumar@outlook.com"
            git config user.name "Wensley-27"
            sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" myfirst_ci_cd/spring-boot-app-manifests/deployment.yml
            git add myfirst_ci_cd/spring-boot-app-manifests/deployment.yml
            git commit -m "Update deployment image to version ${BUILD_NUMBER}"
            git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:master
          '''
        }
      }
    }
  }
}
